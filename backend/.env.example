# ==============================================================================
# LYAXIS IA — Variables de Entorno del Backend
# ==============================================================================

# Secreto criptográfico obligatorio para firma de tokens HMAC-SHA256 (mínimo 32 caracteres)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=genera_un_secreto_seguro_de_al_menos_32_caracteres_aqui

# Base de datos PostgreSQL (Supabase o similar con pooling en producción)
# Si no se define, se usará SQLite local de respaldo (lyaxis.db)
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres?sslmode=require

# Claves de proveedores de Inteligencia Artificial
NVIDIA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Autenticación Google OAuth (Web Client ID)
GOOGLE_CLIENT_ID=1073688660808-amgupffpqddmmo89vemaaupje20531t6.apps.googleusercontent.com

# Servicio de Correo SMTP para envío de códigos OTP (Opcional en desarrollo)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=soporte@lyaxis.lat

# Orígenes CORS permitidos separados por coma (en producción usar tu dominio de Vercel)
ALLOWED_ORIGINS=https://lyaxis-ia.vercel.app,https://lyaxis-webforge.vercel.app,http://localhost:5173,http://localhost:3000
